<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sports Scheduler App' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="navbar">
    <div class="container nav-container">
      <a href="/" class="brand-logo">
        <span class="icon">⚽</span> Sports Scheduler
      </a>
      <nav class="nav-links">
        <% if (currentUser) { %>
          <a href="/dashboard" class="nav-link">Dashboard</a>
          <a href="/sports" class="nav-link">Sports</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/sessions/new" class="btn btn-primary btn-sm">+ Host Match</a>
            <a href="/reports" class="nav-link badge-admin-nav">Admin Reports</a>
          <% } %>
          <div class="user-profile-menu">
            <span class="user-greeting">Hi, <strong><%= currentUser.name %></strong> (<%= currentUser.role %>)</span>
            <a href="/auth/logout" class="btn btn-outline btn-sm">Sign Out</a>
          </div>
        <% } else { %>
          <a href="/auth/login" class="nav-link">Sign In</a>
          <a href="/auth/signup" class="btn btn-primary btn-sm">Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main-content container">
    <% if (success && success.length > 0) { %>
      <% success.forEach(function(msg) { %>
        <div class="alert alert-success">
          <span class="alert-icon">✓</span> <%= msg %>
        </div>
      <% }) %>
    <% } %>

    <% if (error && error.length > 0) { %>
      <% error.forEach(function(msg) { %>
        <div class="alert alert-danger">
          <span class="alert-icon">⚠️</span> <%= msg %>
        </div>
      <% }) %>
    <% } %>
